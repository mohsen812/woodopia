// =====================================
// START
// =====================================

document.addEventListener(
    "DOMContentLoaded",
    () => {

        loadProject();

    }
);


// =====================================
// LOAD PROJECT
// =====================================

async function loadProject() {

    try {

        const response =
            await fetch(API_URL);


        if (!response.ok) {

            throw new Error(
                `API error: ${response.status}`
            );

        }


        const projects =
            await response.json();


        if (!projects.length) {

            console.warn(
                "No FEEMAAS projects found."
            );

            return;

        }


        currentProject =
            projects[0];


        showProject(
            currentProject
        );

    }

    catch (error) {

        console.error(
            "FEEMAAS API Error:",
            error
        );

    }

}


// =====================================
// SHOW PROJECT
// =====================================
function showProject(project) {

    const projectTitle =
        document.getElementById(
            "projectTitle"
        );


    const projectDescription =
        document.getElementById(
            "projectDescription"
        );


    const zoneName =
        document.getElementById(
            "zoneName"
        );


    if (projectTitle) {

        projectTitle.innerText =
            project.title;

    }


    if (projectDescription) {

        projectDescription.innerText =
            project.description || "";

    }


    // ===============================
    // DRAW MAIN CITY MAP
    // ===============================

    drawWorkspace();


    if (
        project.zones &&
        project.zones.length
    ) {

        const zone =
            project.zones[0];


        if (zoneName) {

            zoneName.innerText =
                zone.name;

        }


        if (
            zone.visuals &&
            zone.visuals.length
        ) {

            drawVisual(
                zone.visuals[0]
            );

        }

    }

}


// =====================================
// DRAW WORKSPACE
// =====================================

function drawWorkspace() {

    const svg =
        document.getElementById(
            "visualCanvas"
        );


    if (!svg) {

        return;

    }


    svg.innerHTML = "";


    drawBackground(
        svg
    );


    drawRoad(
        svg
    );


    WORKSPACE_ZONES.forEach(
        zone => {

            drawZone(
                svg,
                zone
            );

        }
    );

}


// =====================================
// DRAW BACKGROUND
// =====================================

function drawBackground(svg) {

    const background =
        document.createElementNS(
            SVG_NS,
            "rect"
        );


    background.setAttribute(
        "x",
        "0"
    );


    background.setAttribute(
        "y",
